# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
DJANGO_LOG_LEVEL=INFO
USE_X_FORWARDED_HOST=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Database Settings (Leave POSTGRES_HOST empty for local SQLite; set to 'db' in Docker/Dokploy)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=pingly
POSTGRES_USER=pingly
POSTGRES_PASSWORD=pingly_secret
DB_CONN_MAX_AGE=60
SQLITE_DB_NAME=db.sqlite3

# Redis Cache Settings (Leave REDIS_URL empty for local LocMemCache; set in Docker/Dokploy)
REDIS_URL=
CACHE_KEY_PREFIX=pingly
CACHE_DEFAULT_TIMEOUT=300
WALLET_BALANCE_CACHE_TTL_SECONDS=15

# Gunicorn Settings (Docker / Dokploy)
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Settings
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_USER=120/minute
THROTTLE_RATE_HEALTH=120/minute
THROTTLE_RATE_OTP_SEND=10/hour
THROTTLE_RATE_OTP_VERIFY=20/hour
THROTTLE_RATE_HANDLE_CHECK=60/minute
THROTTLE_RATE_PROFILE=60/minute
THROTTLE_RATE_RECIPIENT_LOOKUP=30/minute
THROTTLE_RATE_WALLET_ACTION=20/minute
THROTTLE_RATE_WALLET_READ=60/minute
THROTTLE_RATE_TRANSFER_PREPARE=30/minute
THROTTLE_RATE_TRANSFER_SUBMIT=20/minute
THROTTLE_RATE_TRANSACTION_READ=60/minute

# OTP & Identity Settings
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_DEBUG_RETURN_CODE=True

# Twilio SMS Settings (Leave empty for console/dev mode; set all 3 for live SMS delivery)
SMS_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_FAIL_SILENTLY=False

# Wallet Ownership Challenge Settings
WALLET_CHALLENGE_EXPIRY_SECONDS=300
PINGLY_CHALLENGE_DOMAIN=pingly.app

# Stellar Testnet Settings
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_USDC_ASSET_CODE=USDC
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_BASE_FEE=100
STELLAR_TX_TIMEOUT_SECONDS=300
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet/tx
